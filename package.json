{
  "name": "gsuite-mcp",
  "version": "0.4.0",
  "description": "Multi-account MCP server for Gmail, Google Calendar, Google Docs, Google Sheets, and Google Drive.",
  "type": "module",
  "license": "MIT",
  "author": "pranavgade20",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "google-docs",
    "google-sheets",
    "google-drive",
    "gsuite",
    "google-workspace",
    "claude"
  ],
  "bin": {
    "gsuite-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --import tsx/esm src/index.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
