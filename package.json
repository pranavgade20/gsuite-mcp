{
  "name": "gsuite-mcp",
  "version": "0.1.2",
  "description": "MCP server for Gmail + Google Calendar. Bulk export, bulk label modify, draft-first safety, gated send, RFC 5322 reply threading, in-MCP OAuth setup.",
  "type": "module",
  "license": "MIT",
  "author": "pranavgade20",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "google-calendar",
    "gsuite",
    "google-workspace",
    "claude"
  ],
  "bin": {
    "gsuite-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --import tsx/esm src/index.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
